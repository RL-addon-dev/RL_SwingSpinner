package-as: RL_WeaponSwingSpinner

# AX_Modules and AX_Settings, pulled into libs at the tested tag.
externals:
  libs:
    url: https://github.com/RL-addon-dev/AX_Libs.git
    tag: v1.0.0

# The release changelog, instead of one generated from the git log.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Left out of the release zip: repo-only files. LICENSE and NOTICE stay in (GPL).
ignore:
  - README.md
  - Media
  - libs/README.md
  - libs/AX_Settings/README.md
  - libs/AX_Settings/Examples
